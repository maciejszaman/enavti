{
  "name": "enavti",
  "version": "0.3",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "packages/sharedTypes"
  ],
  "scripts": {
    "dev": "bun run --filter client --filter server dev",
    "dev:client": "bun run --filter client dev",
    "dev:server": "bun run --filter server dev",
    "build": "bun run --filter client build && bun run --filter server build",
    "build:client": "bun run --filter client build",
    "build:server": "bun run --filter server build",
    "start": "bun run --filter client --filter server start",
    "install:all": "bun install"
  },
  "packageManager": "bun@1.4.2"
}
